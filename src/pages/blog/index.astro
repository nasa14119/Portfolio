---
import Default from "src/layouts/Default.astro";
import Image from "astro/components/Image.astro";
import Navegation from "@components/App/Navegation.astro";
import HeroImage from "@assets/img/HeroBlog.jpeg";
import HeroImageSkeleton from "@assets/img/HeroBlogSkeleton.jpg";
import PreviewArticle from "@components/Blog/components/PreviewArticle.astro";
import { getCollection } from "astro:content";
type Article = {
  title: string;
  id: string;
  heroImage: string;
  categories: string[];
  date: string;
  url: string;
};
const glob = await getCollection("blog");
const articles = glob.map<Article>(({ data, id }) => ({
  id,
  date: data.date,
  categories: data.categories,
  heroImage: data.heroImage,
  title: data.title,
  url: `/blog/${id}`,
}));
---

<Default>
  <header class="h-screen w-screen relative flex justify-center items-center max-h-screen overflow-hidden">
    <Navegation />
    <div class="absolute inset-0 -z-50 before:absolute before:inset-0 before:bg-primary before:-z-40 before:opacity-40">
      <div
        class="inset-0 absolute bg-cover -z-50 animate-duration-500 animate-fade-in bg-center md:bg-top"
        style=`background-image:url(${HeroImageSkeleton.src})`
      >
        <Image
          src={HeroImage}
          alt="Background"
          class="bg-cover relative w-auto h-full md:w-full md:h-auto object-cover aspect-[9_/_16] md:aspect-video mx-auto -z-50"
          loading="eager"
          id="bg-hero"
        />
      </div>
    </div>
    <h1 class="text-[20vw] md:text-[225px] animate-fade-in-down animate-delay-500 animate-duration-[800ms] select-none">
      Blog
    </h1>
  </header>
  <main>
    <h2 class="text-[10vw] py-2 px-5 font-title text-complementOne">
      Articles
    </h2>
    <section class="grid-articles">
      {articles.map((article) => (
        <PreviewArticle
          date={article.date}
          hashtags={article.categories}
          link={article.url ?? "#"}
          title={article.title}
          img={article.heroImage}
        />
      ))}
    </section>
  </main>
</Default>
<style>
  @reference "@assets/css/index.css";
  .grid-articles {
    @apply grid grid-cols-1 md:grid-cols-3 px-5;
  }
</style>
